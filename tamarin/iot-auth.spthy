theory IoT_Auth_Protocol
begin

builtins: symmetric-encryption

// --- Function Symbols ---
functions:
    xor_keys/2,
    solve_challenge/2

// Protocoll

// M1: device -> server  (device id, session id)
rule Device_Hello:
  [ 
    Fr(~sid),       // Random Session ID
    Fr(~v)          // Vault
  ]
  --[ DeviceHello($did, ~sid) ]->
  [ 
    Out(<'M1', $did, ~sid>),
    SessionD($did, ~sid, ~v),
    SessionS_vault(~v)        // Server vault       
  ]

// M2: server -> device  (challenge)
rule Receive_Device_Hello_Response:
    [ 
      In(<'M1', $did, sid>),
      Fr(~c1),       // challenge indices (modeled as fresh)
      Fr(~r1),       // random value r1
      SessionS_vault(v) 
    ]
    --[ ServerReceiveHello($did, sid, ~c1, ~r1) ]->
    [ 
      Out(<'M2', ~c1, ~r1>),
      SessionS($did, sid, ~c1, ~r1, v)
    ]

// M3: device -> server  (response to challenge)
rule Device_Challenge_Response:
    let 
        k1 = solve_challenge(c1, v)    // derive key from challenge
        payload = <r1, ~t1, ~c2, ~r2> // response and new challenge
        m3 = senc(payload, k1)        // encrypt message contents with derived key
    in    
    [ SessionD($did, sid, v),
      In(<'M2', c1, r1>),
      Fr(~t1),                   // fresh random value t1
      Fr(~c2),                   // fresh challenge indices for server
      Fr(~r2)                    // fresh random value r2
    ]                  
    --[ DeviceChallengeResponse($did, sid, c1, r1, ~c2, ~r2),
        M3Sent(~r2) ]->
    [   
      Out(<'M3', m3>), 
      SessionD_updated($did, sid, ~t1, ~c2, ~r2, k1, v) 
    ]

// M4: server -> device  (response to challenge)
rule Server_Challenge_Response:
    let 
    k1 = solve_challenge(c1, v)   // derive key 1 (same method as device)
    k2 = solve_challenge(c2, v)   // derive key 2 (same method as device)
    t = xor_keys(t1, ~t2)          // shared session key
    in    
    [ 
      SessionS($did, sid, c1, r1, v),
      In(<'M3', senc(<r1, t1, c2, r2>, k1)>),
      Fr(~t2)                   // fresh random value t2
     ]              
    --[ ServerCreateSession($did, sid, t),
        M3Parsed(r2) ]->
    [ 
      Out(<'M4', senc(<r2, ~t2>, k2)>),
      SessionS_final($did, sid, t) 
    ]

// Final step: device processes server's response
rule Device_Finalize:
    let
    k2 = solve_challenge(c2, v) // derive key (same method as server)
    t = xor_keys(t1, t2)        // shared session key
    in
    [ 
    SessionD_updated($did, sid, t1, c2, r2, k1, v),
      In(<'M4', senc(<r2, t2>, k2)>)]
    --[ DeviceCreateSession($did, sid, t) ]->
    [ 
      SessionD_final($did, sid, t)
    ]


// Lemmas to prove

// First check if protocol is executable
lemma Session_executability:
  exists-trace
"
  Ex did sid t #i #j #k.
  DeviceHello(did, sid) @ #i
  & ServerCreateSession(did, sid, t) @ #j
  & DeviceCreateSession(did, sid, t) @ #k
"

// Prove session key t can not be learned by the attacker
lemma Session_key_secrecy:
"
  not(Ex did sid t #i #j #k.
    ServerCreateSession(did, sid, t) @ #i
    & DeviceCreateSession(did, sid, t) @ #j
    & K(t) @ #k
  )
"

// Typing/source lemma to keep the search finite:
// if the server accepts an r2 from M3, it must be attacker-known or originate from a device's M3.
lemma M3_r2_sources [sources]:
"
  All r2 #i.
    M3Parsed(r2) @ #i
    ==>
      (Ex #j. M3Sent(r2) @ #j & #j < #i)
    | (Ex #j. K(r2) @ #j & #j < #i)
"

end
